# ==============================================================================
# God's Eye — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit your actual .env file with real credentials to version control.

# ------------------------------------------------------------------------------
# 1. Vectorize Hindsight Persistent Memory Configuration
# ------------------------------------------------------------------------------
# Vectorize Cloud: https://api.hindsight.vectorize.io
# Self-Hosted Hindsight: http://localhost:8888 (leave API key blank)
# Embedded Fallback: If Vectorize Cloud is unavailable or out of credits,
# God's Eye automatically falls back to an embedded SQLite + Groq engine.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_vectorize_hindsight_api_key_here

# ------------------------------------------------------------------------------
# 2. Groq API Configuration (Required for LLM Synthesis & Reflection)
# ------------------------------------------------------------------------------
# Powers fast structured extraction and cross-temporal competitive synthesis.
# Obtain a key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. Tavily API Configuration (Required for Web Intelligence & News Pulse)
# ------------------------------------------------------------------------------
# Powers real-time search, competitor discovery, and 7-day verified news pulse.
# Obtain a key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 4. Optional Server Settings
# ------------------------------------------------------------------------------
# Default host and port if running directly via Python
HOST=0.0.0.0
PORT=8000
